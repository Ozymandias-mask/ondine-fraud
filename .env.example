# Modèle du fichier .env. NE PAS mettre de vrais secrets ici.
# Générer le vrai fichier avec :  python scripts/generate_env.py
# Le fichier .env est exclu de Git (.gitignore).

# Kafka : identifiant du cluster KRaft (22 caractères, base64 URL)
KAFKA_CLUSTER_ID=change-me-22-chars-id0
KAFKA_UI_USER=admin
KAFKA_UI_PASSWORD=change-me

# Stockage objet S3 (SeaweedFS) : une identité par usage (moindre privilège)
S3_ADMIN_ACCESS_KEY=change-me
S3_ADMIN_SECRET_KEY=change-me
S3_INGESTION_ACCESS_KEY=change-me
S3_INGESTION_SECRET_KEY=change-me
S3_PIPELINE_ACCESS_KEY=change-me
S3_PIPELINE_SECRET_KEY=change-me
S3_ML_ACCESS_KEY=change-me
S3_ML_SECRET_KEY=change-me

# PostgreSQL : compte d'administration et comptes applicatifs
POSTGRES_ADMIN_USER=ondine_admin
POSTGRES_ADMIN_PASSWORD=change-me
PG_INGESTION_PASSWORD=change-me
PG_API_PASSWORD=change-me
PG_ANALYST_PASSWORD=change-me
PG_AIRFLOW_PASSWORD=change-me
PG_MLFLOW_PASSWORD=change-me

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Jeton exigé par l'API de pilotage du simulateur (en-tête X-Control-Token)
SIM_CONTROL_TOKEN=change-me

# Clé secrète de pseudonymisation (hachage des identifiants personnels dans le data lake).
# Ne jamais la changer après la première ingestion : les pseudonymes ne correspondraient plus.
PSEUDONYMISATION_KEY=change-me
