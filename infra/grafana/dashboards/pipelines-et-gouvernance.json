          "rawSql": "SELECT request_id AS demande, request_type AS type, status AS statut, received_at AS reçue, due_at AS échéance, is_overdue AS \"en retard\", approved_by AS \"validée par\", notes FROM governance.data_subject_requests_due ORDER BY received_at DESC LIMIT 50"
