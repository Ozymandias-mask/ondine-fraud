    {
      "id": 29,
      "type": "table",
      "title": "Accès aux données personnelles (7 jours)",
      "description": "Journal d'audit en ajout seul, par compte, action et finalité.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ondine-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ondine-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT l.actor AS compte, coalesce(a.kind, 'inconnu') AS type, l.action, l.purpose AS finalité, count(*) AS accès, max(l.occurred_at) AS dernier FROM audit.access_log l LEFT JOIN governance.authorized_actors a USING (actor) WHERE l.occurred_at > now() - INTERVAL '7 days' GROUP BY 1, 2, 3, 4 ORDER BY accès DESC"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      }
