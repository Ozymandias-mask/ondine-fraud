    {
      "id": 27,
      "type": "table",
      "title": "Incidents de sécurité",
      "description": "Détectés automatiquement dans le journal d'audit (toutes les 15 min).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "ondine-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "ondine-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT incident_id AS \"n°\", detected_at AS détecté, rule AS règle, severity AS gravité, actor AS compte, status AS statut, cnil_deadline AS \"échéance CNIL\", evidence::text AS éléments FROM governance.security_incidents_due ORDER BY detected_at DESC LIMIT 50"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      }
    },
